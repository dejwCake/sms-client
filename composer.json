{
    "name": "dejwcake/sms-client",
    "description": "A generic SMS client library. Supports multiple swappable drivers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "sms"
    ],
    "authors": [
        {
            "name": "David Běhal",
            "email": "behal.david@gmail.com",
            "role": "Fork Developer"
        },
        {
            "name": "Matthew Daly",
            "email": "matthewbdaly@gmail.com",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.367",
        "guzzlehttp/guzzle": "^7.10",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "12.5.3"
    },
    "suggest": {
        "aws/aws-sdk-php": "Allows using the AWS SNS driver"
    },
    "autoload": {
        "psr-4": {
            "DejwCake\\SmsClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DejwCake\\SmsClient\\Tests\\": "tests/"
        }
    }
}
